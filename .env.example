VAPI_ASSISTANT_MIA=asst_mia_vapi_id
VAPI_ASSISTANT_ISLA=asst_isla_vapi_id
VAPI_ASSISTANT_REMY=asst_remy_vapi_id
VAPI_ASSISTANT_CORA=asst_cora_vapi_id
VAPI_ASSISTANT_DREW=asst_drew_vapi_id
VAPI_ASSISTANT_SAGE=asst_sage_vapi_id
VAPI_ASSISTANT_BELLE=asst_belle_vapi_id
VAPI_ASSISTANT_NOVA=asst_nova_vapi_id
VAPI_ASSISTANT_PIPER=asst_piper_vapi_id
VAPI_ASSISTANT_NINA=asst_nina_vapi_id
VAPI_ASSISTANT_ELTON=asst_elton_vapi_id
VAPI_ASSISTANT_LENA=asst_lena_vapi_id
VAPI_ASSISTANT_FINN=asst_finn_vapi_id
VAPI_ASSISTANT_AURORA=asst_aurora_vapi_id
VAPI_ASSISTANT_COLE=asst_cole_vapi_id
VAPI_ASSISTANT_EVA=asst_eva_vapi_id
VAPI_ASSISTANT_BROOK=asst_brook_vapi_id

# ─────────────────────────────────────────────
# OPENAI — Whisper for JARVIS (Precious's voice input)
# ─────────────────────────────────────────────
# platform.openai.com → API Keys
OPENAI_API_KEY=sk-your_openai_api_key

# ─────────────────────────────────────────────
# REPLICATE — Belle virtual try-on (SDXL/ControlNet)
# ─────────────────────────────────────────────
# replicate.com → Account → API Tokens
REPLICATE_API_TOKEN=r8_your_replicate_api_token

# Model versions
REPLICATE_SDXL_VERSION=39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b
REPLICATE_CONTROLNET_VERSION=aff48af9c68d162388d230a2ab003f68d2638d88307bdaf1c2f1ac95079c9613

# ─────────────────────────────────────────────
# OPENWEATHERMAP — Sage environmental intelligence
# ─────────────────────────────────────────────
# openweathermap.org → API Keys
# Requires One Call API 3.0 subscription for UV index
OPENWEATHER_API_KEY=your_openweathermap_api_key

# ─────────────────────────────────────────────
# GOOGLE MAPS — Brook provider proximity search
# ─────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# Required APIs: Maps JavaScript API, Geocoding API, Distance Matrix API
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key

# ─────────────────────────────────────────────
# RESEND — All transactional email
# ─────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=hello@cuteme.com
RESEND_FROM_NAME=CUTEME LTD

# ─────────────────────────────────────────────
# TWILIO — SMS verification and booking alerts
# ─────────────────────────────────────────────
# twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1your_twilio_number

# ─────────────────────────────────────────────
# PAYSTACK — Africa: Mobile Money + cards
# ─────────────────────────────────────────────
# dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Subscription plan codes (create in Paystack dashboard)
PAYSTACK_PLAN_GLOW=PLN_glow_monthly_code
PAYSTACK_PLAN_PRO=PLN_pro_monthly_code
PAYSTACK_PLAN_ELITE=PLN_elite_monthly_code
PAYSTACK_PLAN_PROVIDER_BASIC=PLN_provider_basic_code
PAYSTACK_PLAN_PROVIDER_PRO=PLN_provider_pro_code

# ─────────────────────────────────────────────
# STRIPE — Global payments
# ─────────────────────────────────────────────
# dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_GLOW=price_glow_monthly_id
STRIPE_PRICE_PRO=price_pro_monthly_id
STRIPE_PRICE_ELITE=price_elite_monthly_id
STRIPE_PRICE_PROVIDER_BASIC=price_provider_basic_id
STRIPE_PRICE_PROVIDER_PRO=price_provider_pro_id

# ─────────────────────────────────────────────
# META API — Nina: Instagram + Facebook
# ─────────────────────────────────────────────
# developers.facebook.com → Apps → your app
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_long_lived_access_token
META_PAGE_ID=your_facebook_page_id
META_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ─────────────────────────────────────────────
# TIKTOK API — Nina: TikTok publishing
# ─────────────────────────────────────────────
# developers.tiktok.com → Apps → your app
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ─────────────────────────────────────────────
# PINTEREST API — Nina: Pinterest publishing
# ─────────────────────────────────────────────
# developers.pinterest.com → Apps → your app
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_BOARD_ID=your_pinterest_board_id

# ─────────────────────────────────────────────
# MODASH — Nina: Influencer search and vetting
# ─────────────────────────────────────────────
# modash.io → Settings → API
MODASH_API_KEY=your_modash_api_key

# ─────────────────────────────────────────────
# META ADS API — Finn: Facebook + Instagram ads
# ─────────────────────────────────────────────
META_ADS_ACCOUNT_ID=act_your_meta_ads_account_id
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token

# ─────────────────────────────────────────────
# GOOGLE ADS API — Finn: Google campaigns
# ─────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_ads_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id

# ─────────────────────────────────────────────
# SERPER API — Nova / Cole / Elton: Web research
# ─────────────────────────────────────────────
# serper.dev → API Key
SERPER_API_KEY=your_serper_api_key

# ─────────────────────────────────────────────
# TEACHABLE — Piper: Beauty Academy
# ─────────────────────────────────────────────
# teachable.com → Settings → Integrations → API
TEACHABLE_API_KEY=your_teachable_api_key
TEACHABLE_SCHOOL_SUBDOMAIN=cuteme

# ─────────────────────────────────────────────
# CIRCLE.SO — Aurora: Inner Circle community
# ─────────────────────────────────────────────
# circle.so → Settings → API
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_COMMUNITY_ID=your_circle_community_id

# ─────────────────────────────────────────────
# SENTRY — Real-time error tracking
# ─────────────────────────────────────────────
# sentry.io → Settings → Projects → your project → Client Keys
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ─────────────────────────────────────────────
# N8N — Self-hosted workflow automation
# ─────────────────────────────────────────────
N8N_BASIC_AUTH_USER=your_n8n_username
N8N_BASIC_AUTH_PASSWORD=your_n8n_strong_password
N8N_HOST=n8n.cuteme.com
N8N_WEBHOOK_URL=https://n8n.cuteme.com/webhook
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_32_chars

# ─────────────────────────────────────────────
# PRECCI CONNECT — Configuration
# ─────────────────────────────────────────────
CONNECT_REGISTRATION_FEE_USD=25
CONNECT_BASIC_SUBSCRIPTION_USD=15
CONNECT_PRO_SUBSCRIPTION_USD=30
CONNECT_FEATURED_PRICE_AFRICA_USD=20
CONNECT_FEATURED_PRICE_GLOBAL_USD=50
CONNECT_REFERRAL_FEE_BASIC_USD=3.00
CONNECT_REFERRAL_FEE_PRO_USD=2.00
CONNECT_REFERRAL_FEE_FEATURED_USD=1.50
CONNECT_APPOINTMENT_CODE_EXPIRY_HOURS=24

# ─────────────────────────────────────────────
# CLIENT SUBSCRIPTION TIERS
# ─────────────────────────────────────────────
SUBSCRIPTION_GLOW_USD=9.99
SUBSCRIPTION_PRO_USD=19.99
SUBSCRIPTION_ELITE_USD=29.99

# ─────────────────────────────────────────────
# CAMERA & VISION
# ─────────────────────────────────────────────
CAMERA_FRAME_INTERVAL_MS=3000
CAMERA_FRAME_QUALITY=0.8
VISION_MAX_IMAGE_SIZE_MB=5
VISION_TIMEOUT_MS=30000

# ─────────────────────────────────────────────
# BELLE — Virtual try-on URL proxying
# ─────────────────────────────────────────────
BELLE_SIMULATION_EXPIRY_HOURS=48
BELLE_CLEANUP_INTERVAL_HOURS=1
BELLE_PROXY_BASE_URL=https://api.cuteme.com/api/belle/proxy

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_VOICE_MAX=30
RATE_LIMIT_VOICE_WINDOW_MS=60000
RATE_LIMIT_CAMERA_MAX=20
RATE_LIMIT_CAMERA_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX=30
RATE_LIMIT_PAYMENT_WINDOW_MS=900000
RATE_LIMIT_BOOKING_MAX=60
