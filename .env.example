# FILE: precci/.env.example
# CUTEME LTD — Environment Variables
# Complete template for all 4 phases.
# Gordon fills these privately. Never share. Never commit.
# Copy this file to .env and fill in real values.
# The system works the moment real values are in place.

# ─────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://cuteme.com
BACKEND_URL=https://api.cuteme.com
INTERNAL_API_KEY=your_strong_random_internal_api_key_here

# JWT
JWT_SECRET=your_very_long_random_jwt_secret_minimum_64_chars
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_minimum_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
ALLOWED_ORIGINS=https://cuteme.com,https://www.cuteme.com,https://dashboard.cuteme.com

# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key — backend only, NEVER in frontend
# Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# Anon Key — safe for frontend (authenticated client ops only)
# Supabase dashboard → Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key

# For Next.js frontend (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key

# ─────────────────────────────────────────────
# ANTHROPIC — Claude API (all 28 agents)
# ─────────────────────────────────────────────
# anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key

# Model used by all agents — claude-opus-4-5
CLAUDE_MODEL=claude-opus-4-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_VISION_MAX_TOKENS=2048

# ─────────────────────────────────────────────
# ELEVENLABS — 28 distinct agent voices
# ─────────────────────────────────────────────
# elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Voice IDs — create each voice in ElevenLabs and paste ID here
# Executive Board
ELEVENLABS_VOICE_VIVIENNE=voice_id_for_vivienne_pc001
ELEVENLABS_VOICE_CELESTE=voice_id_for_celeste_pc002
ELEVENLABS_VOICE_MARCUS=voice_id_for_marcus_pc003
