ELEVENLABS_VOICE_FINN=voice_id_for_finn_pc022
ELEVENLABS_VOICE_AURORA=voice_id_for_aurora_pc023
ELEVENLABS_VOICE_COLE=voice_id_for_cole_pc024
ELEVENLABS_VOICE_EVA=voice_id_for_eva_pc025
ELEVENLABS_VOICE_BROOK=voice_id_for_brook_pc027

# ─────────────────────────────────────────────
# VAPI — Always-on voice for all client interactions
# ─────────────────────────────────────────────
# vapi.ai → Dashboard → API Keys
VAPI_API_KEY=your_vapi_private_api_key
VAPI_WEBHOOK_SECRET=your_vapi_webhook_signing_secret

# Public key — safe for frontend
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key

# Vapi Assistant IDs — create one assistant per agent in Vapi
# Executive
VAPI_ASSISTANT_VIVIENNE=asst_vivienne_vapi_id
VAPI_ASSISTANT_GRACE=asst_grace_vapi_id

# Specialist Agents
VAPI_ASSISTANT_LUNA=asst_luna_vapi_id
