ELEVENLABS_VOICE_NADIA=voice_id_for_nadia_pc006
ELEVENLABS_VOICE_SEBASTIAN=voice_id_for_sebastian_pc007

# Specialist Agents — Core
ELEVENLABS_VOICE_GRACE=voice_id_for_grace_pc026
ELEVENLABS_VOICE_LUNA=voice_id_for_luna_pc008
ELEVENLABS_VOICE_ZARA=voice_id_for_zara_pc009
ELEVENLABS_VOICE_MIA=voice_id_for_mia_pc010
