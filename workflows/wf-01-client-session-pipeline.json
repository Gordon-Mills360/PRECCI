{
  "name": "WF-01 — Client Session Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "client-session-start",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-session-start",
      "name": "Session Start Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "notes": "Triggered when client opens PRECCI PWA. Vapi sends session start event to this endpoint."
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "users",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.userId }}"
            }
          ]
        },
        "options": {
          "limit": 1
        }
      },
      "id": "load-user-profile",
      "name": "Load User Profile",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "beauty_profiles",
        "filters": {
          "conditions": [
            {
              "keyName": "user_id",
              "condition": "eq",
              "keyValue": "={{ $json.body.userId }}"
            }
          ]
        },
        "options": {
          "limit": 1
        }
      },
      "id": "load-beauty-profile",
      "name": "Load Beauty Profile",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 460],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/sage/environment",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $json.body.userId }}"
            },
            {
              "name": "city",
              "value": "={{ $('Load User Profile').item.json.city }}"
            },
            {
              "name": "country",
              "value": "={{ $('Load User Profile').item.json.country }}"
            },
            {
              "name": "lat",
              "value": "={{ $('Load User Profile').item.json.lat }}"
            },
            {
              "name": "lng",
              "value": "={{ $('Load User Profile').item.json.lng }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "sage-pull-environment",
      "name": "Sage — Pull Environmental Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": "public",
        "table": "sessions",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.body.sessionId }}",
            "user_id": "={{ $json.body.userId }}",
            "agent_id": "PC-026",
            "channel": "pwa",
            "camera_used": false,
            "completed": false,
            "sage_data": "={{ JSON.stringify($('Sage — Pull Environmental Data').item.json.data) }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "create-session-record",
      "name": "Create Session Record",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "agent_memory",
        "filters": {
          "conditions": [
            {
              "keyName": "user_id",
              "condition": "eq",
              "keyValue": "={{ $json.body.userId }}"
            },
            {
              "keyName": "agent_id",
              "condition": "eq",
              "keyValue": "PC-026"
            }
          ]
        },
        "options": {
          "limit": 10,
          "sort": [{ "field": "created_at", "direction": "DESC" }]
        }
      },
      "id": "load-grace-memory",
      "name": "Load Grace Memory",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 460],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/grace/session",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $json.body.userId }}"
            },
            {
              "name": "sessionId",
              "value": "={{ $json.body.sessionId }}"
            },
            {
              "name": "userProfile",
              "value": "={{ JSON.stringify($('Load User Profile').item.json) }}"
            },
            {
              "name": "beautyProfile",
              "value": "={{ JSON.stringify($('Load Beauty Profile').item.json) }}"
            },
            {
              "name": "sageData",
              "value": "={{ JSON.stringify($('Sage — Pull Environmental Data').item.json.data) }}"
            },
            {
              "name": "memoryContext",
              "value": "={{ JSON.stringify($('Load Grace Memory').item.json) }}"
            },
            {
              "name": "isReturningClient",
              "value": "={{ $('Load Grace Memory').item.json.length > 0 }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "activate-grace",
      "name": "Activate Grace — Route Client",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "routing_log",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "user_id": "={{ $json.body.userId }}",
            "from_agent": "PC-026",
            "to_agent": "={{ $('Activate Grace — Route Client').item.json.routedTo || 'PC-026' }}",
            "routing_reason": "={{ $('Activate Grace — Route Client').item.json.routingReason || 'Session started' }}",
            "timestamp": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-routing",
      "name": "Log Grace Routing Decision",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "alerts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "type": "client_session_started",
            "message": "Grace: New client session started — {{ $json.body.userId.substring(0, 12) }}",
            "severity": "info",
            "agent_id": "PC-026",
            "metadata": "={{ JSON.stringify({ userId: $json.body.userId, sessionId: $json.body.sessionId, isReturning: $('Load Grace Memory').item.json.length > 0, city: $('Load User Profile').item.json.city }) }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-session-alert",
      "name": "Log Session to Activity Feed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 460],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, sessionId: $json.body.sessionId, graceResponse: $('Activate Grace — Route Client').item.json, sageData: $('Sage — Pull Environmental Data').item.json.data, userPlan: $('Load User Profile').item.json.plan }) }}"
      },
      "id": "session-response",
      "name": "Session Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 300]
    }
  ],
  "connections": {
    "Session Start Webhook": {
      "main": [
        [
          { "node": "Load User Profile", "type": "main", "index": 0 },
          { "node": "Load Beauty Profile", "type": "main", "index": 0 }
        ]
      ]
    },
    "Load User Profile": {
      "main": [
        [{ "node": "Sage — Pull Environmental Data", "type": "main", "index": 0 }]
      ]
    },
    "Load Beauty Profile": {
      "main": [
        [{ "node": "Sage — Pull Environmental Data", "type": "main", "index": 0 }]
      ]
    },
    "Sage — Pull Environmental Data": {
      "main": [
        [
          { "node": "Create Session Record", "type": "main", "index": 0 },
          { "node": "Load Grace Memory", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Session Record": {
      "main": [
        [{ "node": "Activate Grace — Route Client", "type": "main", "index": 0 }]
      ]
    },
    "Load Grace Memory": {
      "main": [
        [{ "node": "Activate Grace — Route Client", "type": "main", "index": 0 }]
      ]
    },
    "Activate Grace — Route Client": {
      "main": [
        [
          { "node": "Log Grace Routing Decision", "type": "main", "index": 0 },
          { "node": "Log Session to Activity Feed", "type": "main", "index": 0 }
        ]
      ]
    },
    "Log Grace Routing Decision": {
      "main": [
        [{ "node": "Session Response", "type": "main", "index": 0 }]
      ]
    },
    "Log Session to Activity Feed": {
      "main": [
        [{ "node": "Session Response", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "WF-ERROR-HANDLER"
  },
  "tags": ["cuteme", "client", "session", "core"],
  "active": true
}