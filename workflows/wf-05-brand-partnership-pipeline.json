              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "brandName",
              "value": "={{ $json.body.brandName }}"
            },
            {
              "name": "brandEmail",
              "value": "={{ $json.body.brandEmail }}"
            },
            {
              "name": "coleEvaluation",
              "value": "={{ JSON.stringify($('Cole — Evaluate Brand Fit & Score').item.json) }}"
            },
            {
              "name": "sebastianLegalCheck",
              "value": "={{ JSON.stringify($('Sebastian — Pre-Negotiation Legal Check').item.json) }}"
            },
            {
              "name": "proposedFee",
              "value": "={{ $json.body.proposedFee }}"
            },
            {
              "name": "sessionType",
              "value": "partnership_negotiation"
            }
          ]
