            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-partnership-alert",
      "name": "Log Partnership to Activity Feed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1780, 380],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
