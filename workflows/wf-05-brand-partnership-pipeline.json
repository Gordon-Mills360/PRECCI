// FILE: precci/n8n/WF-05_brand_partnership_pipeline.json
{
  "name": "WF-05 — Brand Partnership Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "brand-partnership-inquiry",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-partnership",
      "name": "Partnership Inquiry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "notes": "Triggered when brand contacts partnerships@cuteme.com or fills contact form. Also triggered when Cole identifies a target brand proactively."
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/cole/evaluate-brand",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "brandName",
              "value": "={{ $json.body.brandName }}"
            },
            {
              "name": "brandEmail",
              "value": "={{ $json.body.brandEmail }}"
            },
            {
              "name": "brandWebsite",
              "value": "={{ $json.body.brandWebsite }}"
            },
            {
              "name": "proposedPartnershipType",
              "value": "={{ $json.body.partnershipType }}"
            },
            {
              "name": "proposedFee",
              "value": "={{ $json.body.proposedFee }}"
            },
            {
              "name": "inquirySource",
              "value": "={{ $json.body.source || 'inbound' }}"
            },
            {
              "name": "sessionType",
              "value": "brand_evaluation"
            }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "cole-evaluate",
      "name": "Cole — Evaluate Brand Fit & Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "score-threshold",
              "leftValue": "={{ $json.score }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "score-check",
      "name": "Score 60+ to Proceed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/sebastian/legal-risk-pre-check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "brandName",
              "value": "={{ $json.body.brandName }}"
            },
            {
              "name": "partnershipType",
              "value": "={{ $json.body.partnershipType }}"
            },
            {
              "name": "proposedFee",
              "value": "={{ $json.body.proposedFee }}"
            },
            {
              "name": "coleEvaluation",
              "value": "={{ JSON.stringify($('Cole — Evaluate Brand Fit & Score').item.json) }}"
            },
            {
              "name": "sessionType",
              "value": "pre_negotiation_legal_check"
            }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "sebastian-pre-check",
      "name": "Sebastian — Pre-Negotiation Legal Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/rafael/initiate-negotiation",
