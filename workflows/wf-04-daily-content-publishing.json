// FILE: precci/n8n/WF-04_daily_content_publishing.json
{
  "name": "WF-04 — Daily Content Publishing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-7am",
      "name": "Cron — Every Day 7:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "Fires every day at 7:00 AM. Triggers the full daily content pipeline."
    },
    {
      "parameters": {
        "operation": "select",
        "schema": "public",
        "table": "users",
        "filters": {
          "conditions": [
            {
              "keyName": "plan_status",
              "condition": "eq",
              "keyValue": "active"
            }
          ]
        },
        "options": {
          "limit": 10000
        }
      },
      "id": "load-active-users",
      "name": "Load All Active Users",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/piper/daily-tips",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ new Date().toISOString().split('T')[0] }}"
            },
            {
              "name": "userCount",
              "value": "={{ $json.length }}"
            },
            {
              "name": "sessionType",
              "value": "daily_tips_generation"
            }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "piper-daily-tips",
      "name": "Piper — Generate Daily Beauty Tips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/nina/morning-content",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ new Date().toISOString().split('T')[0] }}"
            },
            {
              "name": "sessionType",
              "value": "morning_publish"
            },
            {
              "name": "platforms",
              "value": "={{ [\"instagram\", \"tiktok\", \"pinterest\", \"facebook\", \"youtube\"] }}"
            },
            {
              "name": "contentThemes",
              "value": "={{ [\"skin\", \"hair\", \"makeup\", \"style\", \"grooming\", \"fashion\", \"fragrance\", \"body\", \"wellness\"] }}"
            }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "nina-morning-post",
      "name": "Nina — Publish Morning Content All Platforms",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 380]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "hours"
      },
      "id": "wait-finn",
      "name": "Wait 1 Hour for Finn",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [900, 300],
      "notes": "Finn reviews at 8:00 AM after Nina has published."
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/finn/daily-review",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ new Date().toISOString().split('T')[0] }}"
            },
            {
              "name": "sessionType",
              "value": "daily_campaign_review"
            },
            {
              "name": "ninaMorningContent",
              "value": "={{ JSON.stringify($('Nina — Publish Morning Content All Platforms').item.json.published) }}"
            }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "finn-review-ads",
      "name": "Finn — Review & Optimise Ad Campaigns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "content_log",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "agent_id": "PC-018",
            "platform": "app",
            "type": "daily_tip",
            "caption": "={{ $('Piper — Generate Daily Beauty Tips').item.json.tipSummary || 'Daily beauty tip generated' }}",
            "published_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-piper-content",
      "name": "Log Piper Content",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 140],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "content_log",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "agent_id": "PC-019",
            "platform": "all",
            "type": "morning_post",
            "caption": "={{ $('Nina — Publish Morning Content All Platforms').item.json.summary || 'Morning content published' }}",
            "published_at": "={{ new Date().toISOString() }}",
            "engagement": "={{ JSON.stringify($('Nina — Publish Morning Content All Platforms').item.json.engagement || {}) }}"
          }
        },
        "options": {}
      },
      "id": "log-nina-content",
      "name": "Log Nina Content",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 480],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/elton/log-content-metrics",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{ new Date().toISOString().split('T')[0] }}"
            },
            {
              "name": "ninaMorningPublished",
              "value": "={{ $('Nina — Publish Morning Content All Platforms').item.json.postsPublished }}"
            },
            {
              "name": "piperTipsSent",
              "value": "={{ $('Piper — Generate Daily Beauty Tips').item.json.tipsGenerated }}"
            },
            {
              "name": "finnAdjustments",
              "value": "={{ JSON.stringify($('Finn — Review & Optimise Ad Campaigns').item.json.adjustments) }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "elton-log-metrics",
      "name": "Elton — Log All Content & Ad Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "alerts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "type": "daily_content_complete",
            "message": "Piper + Nina + Finn: Daily content pipeline complete — {{ new Date().toISOString().split('T')[0] }}",
            "severity": "info",
            "agent_id": "PC-018",
            "metadata": "={{ JSON.stringify({ date: new Date().toISOString().split('T')[0], ninaPosts: $('Nina — Publish Morning Content All Platforms').item.json.postsPublished, piperTips: $('Piper — Generate Daily Beauty Tips').item.json.tipsGenerated }) }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-daily-complete",
      "name": "Log Daily Content Pipeline Complete",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1560, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    }
  ],
  "connections": {
