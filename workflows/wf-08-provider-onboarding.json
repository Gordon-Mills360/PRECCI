
{
  "name": "WF-08 — Provider Onboarding",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "provider-onboarding-complete",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-provider",
      "name": "Provider Registration Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "notes": "Triggered when a provider completes registration at precci.com/connect. Brook receives the registration data."
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/providers/charge-registration",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "providerId",
              "value": "={{ $json.body.providerId }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "amount",
              "value": 25
            },
            {
              "name": "currency",
              "value": "USD"
            },
            {
              "name": "gateway",
              "value": "={{ $json.body.gateway }}"
            },
            {
              "name": "paymentMethod",
              "value": "={{ $json.body.paymentMethod }}"
            },
            {
              "name": "mobileMoneyNumber",
              "value": "={{ $json.body.mobileMoneyNumber }}"
            },
            {
              "name": "mobileMoneyNetwork",
              "value": "={{ $json.body.mobileMoneyNetwork }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "charge-registration-fee",
      "name": "Charge $25 Registration Fee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "payment-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "payment-check",
      "name": "Registration Fee Paid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "service_providers",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.providerId }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "registration_fee_paid": true,
            "registration_fee_amount": 25,
            "registration_fee_paid_at": "={{ new Date().toISOString() }}",
            "updated_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "mark-fee-paid",
      "name": "Mark Registration Fee Paid",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 180],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/payments/setup-provider-subscription",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
