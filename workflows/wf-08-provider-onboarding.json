            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "subscriptionTier",
              "value": "={{ $json.body.subscriptionTier }}"
            },
            {
              "name": "gateway",
              "value": "={{ $json.body.gateway }}"
            },
            {
              "name": "mobileMoneyNumber",
              "value": "={{ $json.body.mobileMoneyNumber }}"
            },
            {
              "name": "featuredPlacement",
              "value": "={{ $json.body.featuredPlacement }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "setup-subscription",
      "name": "Set Up Monthly Subscription Auto-Billing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 340]
    },
    {
      "parameters": {
