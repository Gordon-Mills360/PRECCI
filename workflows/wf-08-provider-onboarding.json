            },
            {
              "name": "services",
              "value": "={{ $json.body.services }}"
            },
            {
              "name": "city",
              "value": "={{ $json.body.city }}"
            },
            {
              "name": "subscriptionTier",
              "value": "={{ $json.body.subscriptionTier }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "activate-voice-agent",
      "name": "Brook — Activate Provider CUTEME Voice Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/lena/send-provider-welcome",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
