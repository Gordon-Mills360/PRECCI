            },
            {
              "name": "ownerName",
              "value": "={{ $json.body.ownerName }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "subscriptionTier",
              "value": "={{ $json.body.subscriptionTier }}"
            },
            {
              "name": "city",
              "value": "={{ $json.body.city }}"
            }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "lena-welcome-provider",
      "name": "Lena — Send Provider Welcome Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 340]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/sebastian/send-provider-agreement",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "providerId",
              "value": "={{ $json.body.providerId }}"
            },
            {
              "name": "businessName",
              "value": "={{ $json.body.businessName }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "country",
              "value": "={{ $json.body.country }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "sebastian-provider-agreement",
      "name": "Sebastian — Send Standard Provider Agreement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 500]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "service_providers",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.providerId }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "active": true,
            "vapi_assistant_id": "={{ $('Brook — Activate Provider CUTEME Voice Agent').item.json.vapiAssistantId }}",
            "updated_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "activate-provider",
      "name": "Activate Provider in Marketplace",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 340],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "revenue_summary",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ new Date().toISOString().split('T')[0] }}",
            "stream": "provider_registration_fees",
            "amount": 25,
            "currency": "USD",
            "transaction_count": 1,
            "notes": "New provider: {{ $json.body.businessName }} — {{ $json.body.city }}, {{ $json.body.country }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "celeste-reg-fee",
      "name": "Celeste — Log Registration Fee Revenue",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 180],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "alerts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "type": "brook_provider_onboarded",
            "message": "Brook: New provider onboarded — {{ $json.body.businessName }} ({{ $json.body.city }}, {{ $json.body.country }}) — {{ $json.body.subscriptionTier }} plan",
            "severity": "info",
            "agent_id": "PC-027",
            "metadata": "={{ JSON.stringify({ providerId: $json.body.providerId, businessName: $json.body.businessName, city: $json.body.city, country: $json.body.country, subscriptionTier: $json.body.subscriptionTier, services: $json.body.services, featured: $json.body.featuredPlacement }) }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-provider-onboarded",
      "name": "Log Provider Onboarding to Activity Feed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 500],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "alerts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "type": "provider_registration_payment_failed",
            "message": "Brook: Provider registration payment FAILED — {{ $json.body.businessName }} ({{ $json.body.email }})",
            "severity": "warn",
            "agent_id": "PC-027",
            "metadata": "={{ JSON.stringify({ providerId: $json.body.providerId, businessName: $json.body.businessName, email: $json.body.email, gateway: $json.body.gateway }) }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-payment-failed",
      "name": "Log Payment Failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 500],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, providerId: $json.body.providerId, businessName: $json.body.businessName, activated: true, vapiAgentActivated: true }) }}"
      },
      "id": "provider-response",
      "name": "Provider Onboarding Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 340]
    }
  ],
  "connections": {
