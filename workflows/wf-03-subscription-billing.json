// FILE: precci/n8n/WF-03_subscription_billing.json
{
  "name": "WF-03 — Subscription & Billing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "subscription-event",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-subscription",
      "name": "Subscription Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "notes": "Receives events from Paystack and Stripe webhooks when payment succeeds or subscription changes."
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "gateway-check",
              "leftValue": "={{ $json.body.gateway }}",
              "rightValue": "paystack",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "gateway-switch",
      "name": "Paystack or Stripe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/payments/verify-paystack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reference",
              "value": "={{ $json.body.reference }}"
            },
            {
              "name": "event",
              "value": "={{ $json.body.event }}"
            }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "verify-paystack",
      "name": "Verify Paystack Payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/payments/verify-stripe",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "paymentIntentId",
              "value": "={{ $json.body.paymentIntentId }}"
            },
            {
              "name": "subscriptionId",
              "value": "={{ $json.body.subscriptionId }}"
            },
            {
              "name": "event",
              "value": "={{ $json.body.event }}"
            }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "verify-stripe",
      "name": "Verify Stripe Payment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": "public",
        "table": "subscriptions",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "user_id": "={{ $json.body.userId }}",
            "plan": "={{ $json.body.plan }}",
            "status": "active",
            "amount": "={{ $json.body.amount }}",
            "currency": "={{ $json.body.currency || 'USD' }}",
            "gateway": "={{ $json.body.gateway }}",
            "gateway_reference": "={{ $json.body.reference || $json.body.subscriptionId }}",
            "billing_cycle": "monthly",
            "current_period_start": "={{ new Date().toISOString() }}",
            "current_period_end": "={{ new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString() }}",
            "updated_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "upsert-subscription",
      "name": "Upsert Subscription Record",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "users",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.userId }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "plan": "={{ $json.body.plan }}",
            "plan_status": "active",
            "updated_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "update-user-plan",
      "name": "Update User Plan in Database",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 460],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "revenue_summary",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ new Date().toISOString().split('T')[0] }}",
            "stream": "app_subscriptions",
            "amount": "={{ $json.body.amount }}",
            "currency": "={{ $json.body.currency || 'USD' }}",
            "transaction_count": 1,
            "notes": "={{ $json.body.plan + ' plan — ' + $json.body.gateway }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "celeste-log-revenue",
      "name": "Celeste — Log Revenue",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1120, 300],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "transactions",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "user_id": "={{ $json.body.userId }}",
            "amount": "={{ $json.body.amount }}",
            "currency": "={{ $json.body.currency || 'USD' }}",
            "type": "subscription",
            "gateway": "={{ $json.body.gateway }}",
            "gateway_reference": "={{ $json.body.reference || $json.body.subscriptionId }}",
            "status": "success",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-transaction",
      "name": "Log Transaction Record",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1120, 460],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/lena/send-receipt",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $json.body.userId }}"
            },
            {
              "name": "plan",
              "value": "={{ $json.body.plan }}"
            },
            {
              "name": "amount",
              "value": "={{ $json.body.amount }}"
            },
            {
              "name": "currency",
              "value": "={{ $json.body.currency || 'USD' }}"
            },
            {
              "name": "gateway",
              "value": "={{ $json.body.gateway }}"
            },
            {
              "name": "reference",
              "value": "={{ $json.body.reference || $json.body.subscriptionId }}"
            }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "lena-receipt",
      "name": "Lena — Send Receipt & Premium Welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "glow-plus-check",
              "leftValue": "={{ ['glow', 'pro', 'elite'].includes($json.body.plan) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-inner-circle-eligible",
      "name": "Is Glow Tier or Above?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 460]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_URL }}/api/agents/aurora/invite-inner-circle",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "userId",
              "value": "={{ $json.body.userId }}"
            },
            {
              "name": "plan",
              "value": "={{ $json.body.plan }}"
            }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "aurora-inner-circle-invite",
      "name": "Aurora — Inner Circle Voice Invitation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 380]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "alerts",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "type": "subscription_activated",
            "message": "Celeste: Subscription activated — {{ $json.body.plan }} — ${{ $json.body.amount }} via {{ $json.body.gateway }}",
            "severity": "info",
            "agent_id": "PC-002",
            "metadata": "={{ JSON.stringify({ userId: $json.body.userId, plan: $json.body.plan, amount: $json.body.amount, gateway: $json.body.gateway }) }}",
            "created_at": "={{ new Date().toISOString() }}"
          }
        },
        "options": {}
      },
      "id": "log-subscription-alert",
      "name": "Log Subscription to Activity Feed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1560, 220],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "PRECCI Supabase"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"plan\": \"{{ $json.body.plan }}\", \"activated\": true }"
      },
      "id": "billing-response",
      "name": "Billing Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1780, 300]
    }
  ],
  "connections": {
    "Subscription Webhook": {
      "main": [
        [{ "node": "Paystack or Stripe?", "type": "main", "index": 0 }]
      ]
    },
    "Paystack or Stripe?": {
      "main": [
        [{ "node": "Verify Paystack Payment", "type": "main", "index": 0 }],
        [{ "node": "Verify Stripe Payment", "type": "main", "index": 0 }]
      ]
    },
    "Verify Paystack Payment": {
      "main": [
        [
          { "node": "Upsert Subscription Record", "type": "main", "index": 0 },
          { "node": "Update User Plan in Database", "type": "main", "index": 0 }
        ]
      ]
    },
    "Verify Stripe Payment": {
      "main": [
        [
          { "node": "Upsert Subscription Record", "type": "main", "index": 0 },
          { "node": "Update User Plan in Database", "type": "main", "index": 0 }
        ]
      ]
    },
    "Upsert Subscription Record": {
      "main": [
        [
          { "node": "Celeste — Log Revenue", "type": "main", "index": 0 },
          { "node": "Log Transaction Record", "type": "main", "index": 0 }
        ]
      ]
    },
    "Update User Plan in Database": {
      "main": [
        [
          { "node": "Lena — Send Receipt & Premium Welcome", "type": "main", "index": 0 },
          { "node": "Is Glow Tier or Above?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Celeste — Log Revenue": {
      "main": [
        [{ "node": "Log Subscription to Activity Feed", "type": "main", "index": 0 }]
      ]
    },
    "Lena — Send Receipt & Premium Welcome": {
      "main": [
        [{ "node": "Billing Response", "type": "main", "index": 0 }]
      ]
    },
    "Is Glow Tier or Above?": {
      "main": [
        [{ "node": "Aurora — Inner Circle Voice Invitation", "type": "main", "index": 0 }],
        [{ "node": "Billing Response", "type": "main", "index": 0 }]
      ]
    },
    "Aurora — Inner Circle Voice Invitation": {
      "main": [
        [{ "node": "Billing Response", "type": "main", "index": 0 }]
      ]
    },
    "Log Subscription to Activity Feed": {
      "main": [
        [{ "node": "Billing Response", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": "WF-ERROR-HANDLER"
  },
  "tags": ["cuteme", "billing", "subscription", "celeste", "lena", "aurora"],
  "active": true
}